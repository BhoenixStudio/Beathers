{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/scripts/*"],
      "@data": ["./src/data/index.js"],
      "@helpers": ["./src/scripts/helpers/index.js"],
      "@commands": ["./src/scripts/commands/index.js"],
      "@commandsList": ["./src/scripts/commands/list.js"],
      "@types": ["./src/scripts/types.ts"]
    }
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
